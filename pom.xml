<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
	xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
	<modelVersion>4.0.0</modelVersion>
	<parent>
		<groupId>org.springframework.boot</groupId>
		<artifactId>spring-boot-starter-parent</artifactId>
		<version>4.2.0</version>
		<relativePath/>
	</parent>
	<groupId>com.igorpujovic</groupId>
	<artifactId>finance-tracker</artifactId>
	<version>0.0.1-SNAPSHOT</version>
	<name>finance-tracker</name>
	<description>Imports bank statements, categorizes them, and reports monthly spending in RSD</description>

	<properties>
		<java.version>21</java.version>
		<commons-csv.version>1.14.1</commons-csv.version>
		<springdoc.version>3.2.0</springdoc.version>
	</properties>

	<dependencies>
		<dependency>
			<groupId>org.springframework.boot</groupId>
			<artifactId>spring-boot-starter-data-jpa</artifactId>
		</dependency>
		<dependency>
			<groupId>org.springframework.boot</groupId>
			<artifactId>spring-boot-starter-flyway</artifactId>
		</dependency>
		<dependency>
			<groupId>org.springframework.boot</groupId>
			<artifactId>spring-boot-starter-validation</artifactId>
		</dependency>
		<dependency>
			<groupId>org.springframework.boot</groupId>
			<artifactId>spring-boot-starter-webmvc</artifactId>
		</dependency>
		<dependency>
			<groupId>org.flywaydb</groupId>
			<artifactId>flyway-database-postgresql</artifactId>
		</dependency>

		<!-- Reading statements and writing report exports. One CSV dialect, one library. -->
		<dependency>
			<groupId>org.apache.commons</groupId>
			<artifactId>commons-csv</artifactId>
			<version>${commons-csv.version}</version>
		</dependency>

		<!-- One OpenAPI document, two viewers. Verified non-conflicting: both starters
		     share springdoc-openapi-starter-webmvc-api and add only their own renderer. -->
		<dependency>
			<groupId>org.springdoc</groupId>
			<artifactId>springdoc-openapi-starter-webmvc-ui</artifactId>
			<version>${springdoc.version}</version>
		</dependency>
		<dependency>
			<groupId>org.springdoc</groupId>
			<artifactId>springdoc-openapi-starter-webmvc-scalar</artifactId>
			<version>${springdoc.version}</version>
		</dependency>

		<dependency>
			<groupId>org.postgresql</groupId>
			<artifactId>postgresql</artifactId>
			<scope>runtime</scope>
		</dependency>

		<dependency>
			<groupId>org.springframework.boot</groupId>
			<artifactId>spring-boot-starter-data-jpa-test</artifactId>
			<scope>test</scope>
		</dependency>
		<dependency>
			<groupId>org.springframework.boot</groupId>
			<artifactId>spring-boot-starter-flyway-test</artifactId>
			<scope>test</scope>
		</dependency>
		<dependency>
			<groupId>org.springframework.boot</groupId>
			<artifactId>spring-boot-starter-validation-test</artifactId>
			<scope>test</scope>
		</dependency>
		<dependency>
			<groupId>org.springframework.boot</groupId>
			<artifactId>spring-boot-starter-webmvc-test</artifactId>
			<scope>test</scope>
		</dependency>

		<!-- ADR-0006: query-shaped logic is tested against a real PostgreSQL.
		     Testcontainers 2.x renamed its modules; the old org.testcontainers:postgresql
		     coordinates stop at 1.21.4 and do not exist for the version Boot 4.2 manages. -->
		<dependency>
			<groupId>org.springframework.boot</groupId>
			<artifactId>spring-boot-testcontainers</artifactId>
			<scope>test</scope>
		</dependency>
		<dependency>
			<groupId>org.testcontainers</groupId>
			<artifactId>testcontainers-postgresql</artifactId>
			<scope>test</scope>
		</dependency>
		<dependency>
			<groupId>org.testcontainers</groupId>
			<artifactId>testcontainers-junit-jupiter</artifactId>
			<scope>test</scope>
		</dependency>
	</dependencies>

	<build>
		<plugins>
			<plugin>
				<groupId>org.springframework.boot</groupId>
				<artifactId>spring-boot-maven-plugin</artifactId>
			</plugin>
			<!-- Generates Category_, Transaction_ and friends, so queries and sorts name
			     entity properties through compiled attributes instead of string literals:
			     a renamed field then breaks the build rather than a request.
			     Generating and consuming them are two separate compilations, and they have
			     to stay separate — see the comments on the executions below and
			     docs/adr/0007. -->
			<plugin>
				<groupId>org.apache.maven.plugins</groupId>
				<artifactId>maven-compiler-plugin</artifactId>
				<configuration>
					<!-- The incremental check and the annotation processor disagree. With it
					     on, a single `mvn clean test` compiles all 43 sources, reports
					     success, and writes 42 class files: one class that reads a generated
					     `*_` metamodel is silently left out, and which one varies between
					     runs. The application then starts without it, so the symptom is a
					     404 from an endpoint whose controller is missing rather than a build
					     failure. Recompiling everything costs a second and cannot do that. -->
					<incrementalCompilation>none</incrementalCompilation>
					<!-- Each compilation gets its own javac process. ADR-0007: in-process
					     javac is reused across the executions of one Maven run, and a
					     compilation that is not the first in its JVM is the one that writes
					     the broken class files. -->
					<fork>true</fork>
				</configuration>
				<executions>
					<!-- Pass one: run the processor and write the metamodel sources. Nothing
					     is compiled to class files here, so nothing it writes can be wrong.
					     Its own directory, not generated-sources/annotations, because every
					     compiler execution clears its generated-sources directory before it
					     runs: sharing one would have pass two delete what pass one wrote. -->
					<execution>
						<id>metamodel</id>
						<phase>generate-sources</phase>
						<goals>
							<goal>compile</goal>
						</goals>
						<configuration>
							<proc>only</proc>
							<generatedSourcesDirectory>
								${project.build.directory}/generated-sources/metamodel
							</generatedSourcesDirectory>
							<annotationProcessorPaths>
								<path>
									<groupId>org.hibernate.orm</groupId>
									<artifactId>hibernate-jpamodelgen</artifactId>
									<version>${hibernate.version}</version>
								</path>
							</annotationProcessorPaths>
						</configuration>
					</execution>
					<!-- Pass two: compile the sources and the generated metamodel together,
					     with the processor switched off. ADR-0007: it is annotation
					     processing in the same javac run that corrupts the class files, and
					     a run with no processing rounds has never done it. The source roots
					     are named because the directory above is registered by the execution
					     that generates into it, which is no longer this one. -->
					<execution>
						<id>default-compile</id>
						<configuration>
							<proc>none</proc>
							<compileSourceRoots>
								<root>${project.basedir}/src/main/java</root>
								<root>${project.build.directory}/generated-sources/metamodel</root>
							</compileSourceRoots>
						</configuration>
					</execution>
					<!-- No entity lives in src/test/java, so there is no metamodel to
					     generate for the tests and nothing for a processor to do. -->
					<execution>
						<id>default-testCompile</id>
						<configuration>
							<proc>none</proc>
						</configuration>
					</execution>
				</executions>
			</plugin>
		</plugins>
	</build>

</project>
