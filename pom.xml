<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
	xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
	<modelVersion>4.0.0</modelVersion>
	<parent>
		<groupId>org.springframework.boot</groupId>
		<artifactId>spring-boot-starter-parent</artifactId>
		<version>4.2.0</version>
		<relativePath/>
	</parent>
	<groupId>com.igorpujovic</groupId>
	<artifactId>finance-tracker</artifactId>
	<version>0.0.1-SNAPSHOT</version>
	<name>finance-tracker</name>
	<description>Imports bank statements, categorizes them, and reports monthly spending in RSD</description>

	<properties>
		<java.version>21</java.version>
		<commons-csv.version>1.14.1</commons-csv.version>
		<springdoc.version>3.2.0</springdoc.version>

		<!-- The client (ADR-0008). Node is downloaded by the build rather than
		     required of the machine, so `./mvnw package` and `docker compose up`
		     need the same thing of a contributor as they did before the frontend
		     existed: a JDK, or nothing but Docker.

		     `./mvnw test -P backend-only` skips the client entirely for
		     backend-only work. The jar that profile produces has no UI in it, so
		     it is for a fast test loop and not for anything that gets shipped.
		     Prefer the profile over setting these two by hand: skipping the
		     install without also skipping the test run would leave `npm test` to
		     be invoked with no node_modules to run it. -->
		<frontend-maven-plugin.version>1.15.1</frontend-maven-plugin.version>
		<node.version>v22.22.2</node.version>
		<frontend.skip>false</frontend.skip>
		<frontend.test.skip>false</frontend.test.skip>
	</properties>

	<dependencies>
		<dependency>
			<groupId>org.springframework.boot</groupId>
			<artifactId>spring-boot-starter-data-jpa</artifactId>
		</dependency>
		<dependency>
			<groupId>org.springframework.boot</groupId>
			<artifactId>spring-boot-starter-flyway</artifactId>
		</dependency>
		<dependency>
			<groupId>org.springframework.boot</groupId>
			<artifactId>spring-boot-starter-validation</artifactId>
		</dependency>
		<dependency>
			<groupId>org.springframework.boot</groupId>
			<artifactId>spring-boot-starter-webmvc</artifactId>
		</dependency>
		<!-- The Kurs client of ADR-0005. Boot 4 is modular and `spring-boot-starter-webmvc`
		     brings only the server half of spring-web: without this module there is no
		     autoconfigured `RestClient.Builder` and no `HttpClientSettings`, so the client
		     would have to be assembled by hand and would carry neither this project's
		     Jackson 3 message converters nor a timeout. -->
		<dependency>
			<groupId>org.springframework.boot</groupId>
			<artifactId>spring-boot-restclient</artifactId>
		</dependency>
		<dependency>
			<groupId>org.flywaydb</groupId>
			<artifactId>flyway-database-postgresql</artifactId>
		</dependency>

		<!-- Reading statements and writing report exports. One CSV dialect, one library. -->
		<dependency>
			<groupId>org.apache.commons</groupId>
			<artifactId>commons-csv</artifactId>
			<version>${commons-csv.version}</version>
		</dependency>

		<!-- One OpenAPI document, two viewers. Verified non-conflicting: both starters
		     share springdoc-openapi-starter-webmvc-api and add only their own renderer. -->
		<dependency>
			<groupId>org.springdoc</groupId>
			<artifactId>springdoc-openapi-starter-webmvc-ui</artifactId>
			<version>${springdoc.version}</version>
		</dependency>
		<dependency>
			<groupId>org.springdoc</groupId>
			<artifactId>springdoc-openapi-starter-webmvc-scalar</artifactId>
			<version>${springdoc.version}</version>
		</dependency>

		<dependency>
			<groupId>org.postgresql</groupId>
			<artifactId>postgresql</artifactId>
			<scope>runtime</scope>
		</dependency>

		<dependency>
			<groupId>org.springframework.boot</groupId>
			<artifactId>spring-boot-starter-data-jpa-test</artifactId>
			<scope>test</scope>
		</dependency>
		<dependency>
			<groupId>org.springframework.boot</groupId>
			<artifactId>spring-boot-starter-flyway-test</artifactId>
			<scope>test</scope>
		</dependency>
		<dependency>
			<groupId>org.springframework.boot</groupId>
			<artifactId>spring-boot-starter-validation-test</artifactId>
			<scope>test</scope>
		</dependency>
		<dependency>
			<groupId>org.springframework.boot</groupId>
			<artifactId>spring-boot-starter-webmvc-test</artifactId>
			<scope>test</scope>
		</dependency>

		<!-- ADR-0006: query-shaped logic is tested against a real PostgreSQL.
		     Testcontainers 2.x renamed its modules; the old org.testcontainers:postgresql
		     coordinates stop at 1.21.4 and do not exist for the version Boot 4.2 manages. -->
		<dependency>
			<groupId>org.springframework.boot</groupId>
			<artifactId>spring-boot-testcontainers</artifactId>
			<scope>test</scope>
		</dependency>
		<dependency>
			<groupId>org.testcontainers</groupId>
			<artifactId>testcontainers-postgresql</artifactId>
			<scope>test</scope>
		</dependency>
		<dependency>
			<groupId>org.testcontainers</groupId>
			<artifactId>testcontainers-junit-jupiter</artifactId>
			<scope>test</scope>
		</dependency>
	</dependencies>

	<build>
		<!-- Declared because the client's build output has to join the jar's
		     static resources, and declaring `<resources>` at all replaces the
		     default — so `src/main/resources` is named here as well. Dropping it
		     would quietly take the Flyway migrations and
		     application.properties out of the jar. -->
		<resources>
			<resource>
				<directory>src/main/resources</directory>
			</resource>
			<!-- Spring serves `static/` from the classpath, so the built client
			     lands at `/` with no controller and no configuration. Written by
			     the Vite build during generate-resources, which runs before this
			     is copied in process-resources. When the client build is skipped
			     this directory does not exist, and Maven passes over a missing
			     resource directory with a notice rather than a failure. -->
			<resource>
				<directory>frontend/dist</directory>
				<targetPath>static</targetPath>
			</resource>
		</resources>
		<plugins>
			<plugin>
				<groupId>org.springframework.boot</groupId>
				<artifactId>spring-boot-maven-plugin</artifactId>
			</plugin>
			<!-- Builds the React client into `frontend/dist` (ADR-0008).
			     Deliberately part of the Maven build rather than a stage in the
			     Dockerfile: CI runs `./mvnw verify`, and a client built only by
			     Docker would be a client CI never compiles, in a jar that
			     differs from the one `docker compose` ships.

			     Bound to generate-resources, which sits between the two compiler
			     executions of ADR-0007 and forks no javac of its own — nothing
			     here affects that arrangement. -->
			<plugin>
				<groupId>com.github.eirslett</groupId>
				<artifactId>frontend-maven-plugin</artifactId>
				<version>${frontend-maven-plugin.version}</version>
				<configuration>
					<workingDirectory>frontend</workingDirectory>
					<nodeVersion>${node.version}</nodeVersion>
					<skip>${frontend.skip}</skip>
				</configuration>
				<executions>
					<!-- Node and npm are installed into `frontend/node`, which is
					     git-ignored. Not under `target/`, on purpose: `mvn clean`
					     would then throw away a 30 MB download that no source
					     change can invalidate. -->
					<execution>
						<id>install-node-and-npm</id>
						<phase>generate-resources</phase>
						<goals>
							<goal>install-node-and-npm</goal>
						</goals>
					</execution>
					<!-- `ci`, not `install`: it installs exactly what
					     package-lock.json pins and fails if the lockfile and
					     package.json disagree, which is what a reproducible build
					     wants and what `install` would quietly paper over. -->
					<execution>
						<id>npm-ci</id>
						<phase>generate-resources</phase>
						<goals>
							<goal>npm</goal>
						</goals>
						<configuration>
							<arguments>ci</arguments>
						</configuration>
					</execution>
					<!-- `npm run build` typechecks before it bundles, so a type
					     error in the client fails this build rather than shipping
					     a page that breaks in the browser. -->
					<execution>
						<id>npm-build</id>
						<phase>generate-resources</phase>
						<goals>
							<goal>npm</goal>
						</goals>
						<configuration>
							<arguments>run build</arguments>
						</configuration>
					</execution>
					<!-- The client's own tests, in the phase Maven runs tests in,
					     so that `./mvnw verify` means "everything is green" on
					     both sides of the project rather than only the Java one. -->
					<execution>
						<id>npm-test</id>
						<phase>test</phase>
						<goals>
							<goal>npm</goal>
						</goals>
						<configuration>
							<arguments>run test</arguments>
							<!-- Its own switch rather than the plugin-wide one,
							     because the image build wants the client built
							     and its tests skipped: the Dockerfile passes
							     `-Dfrontend.test.skip=true` beside Maven's own
							     `-DskipTests`, which this plugin does not read. -->
							<skip>${frontend.test.skip}</skip>
						</configuration>
					</execution>
				</executions>
			</plugin>
			<!-- Generates Category_, Transaction_ and friends, so queries and sorts name
			     entity properties through compiled attributes instead of string literals:
			     a renamed field then breaks the build rather than a request.
			     Generating and consuming them are two separate compilations, and they have
			     to stay separate — see the comments on the executions below and
			     docs/adr/0007. -->
			<plugin>
				<groupId>org.apache.maven.plugins</groupId>
				<artifactId>maven-compiler-plugin</artifactId>
				<configuration>
					<!-- No incremental setting, deliberately. Step 2 set
					     `incrementalCompilation`, which is not a parameter this plugin has
					     ever had: Maven ignored it and said so in a warning nobody read, so
					     the setting recorded as the cure for that step's missing-class bug
					     was never once in effect. The real parameter is
					     `useIncrementalCompilation`, and its sense is the reverse of its
					     name — `false` compiles only the sources it thinks are stale. Set
					     that way it compiled 43 of 54 sources after a `clean` and brought
					     the corruption of ADR-0007 back at its worst. The default is a full
					     recompile whenever anything changed, which is both what is wanted
					     and what every measurement in ADR-0007 was taken under. -->
					<!-- Each compilation gets its own javac process. ADR-0007: in-process
					     javac is reused across the executions of one Maven run, and a
					     compilation that is not the first in its JVM is the one that writes
					     the broken class files. The executable is named rather than left to
					     autodetection, which fails here and falls back to whatever `javac`
					     is on the PATH — a different JDK, or none. -->
					<fork>true</fork>
					<executable>${java.home}/bin/javac</executable>
					<!-- Declared for the plugin rather than for the one execution that uses
					     it, so that an IDE reading this pom can find the processor and
					     generate the metamodel for itself. The two executions that compile
					     run with `proc` off and ignore it. -->
					<annotationProcessorPaths>
						<path>
							<groupId>org.hibernate.orm</groupId>
							<artifactId>hibernate-jpamodelgen</artifactId>
							<version>${hibernate.version}</version>
						</path>
					</annotationProcessorPaths>
					<!-- The processor's entity index is off. It exists so that the processor
					     can validate HQL across compilations, which this project does not
					     use: nothing here writes HQL in an annotation, and the metamodel is
					     generated without it. Leaving it on writes twenty-one index
					     resources into the annotation output directory, which the editor's
					     own processor run then cannot create, and it fails with "could not
					     write entity index / Source file already created" — taking the rest
					     of the editor's build with it. Declared for the plugin so that an
					     IDE reading this pom switches it off too. -->
					<compilerArgs>
						<arg>-Aindex=false</arg>
					</compilerArgs>
				</configuration>
				<executions>
					<!-- Pass one: run the processor and write the metamodel sources. Nothing
					     is compiled to class files here, so nothing it writes can be wrong.
					     It writes to the conventional generated-sources/annotations, which is
					     the path an IDE looks in: put the metamodel anywhere else and the
					     editor cannot resolve `Transaction_` even though the build can. -->
					<execution>
						<id>metamodel</id>
						<phase>generate-sources</phase>
						<goals>
							<goal>compile</goal>
						</goals>
						<configuration>
							<proc>only</proc>
						</configuration>
					</execution>
					<!-- Pass two: compile the sources and the generated metamodel together,
					     with the processor switched off. ADR-0007: it is annotation
					     processing in the same javac run that corrupts the class files, and
					     a run with no processing rounds has never done it. The source roots
					     are named because the generated directory is registered as one by
					     the execution that generates into it, which is no longer this one.
					     Its own generated directory points at a scratch path it will never
					     write to, because a compiler execution clears that directory before
					     it runs and this one would otherwise delete the metamodel pass one
					     just generated. -->
					<execution>
						<id>default-compile</id>
						<configuration>
							<proc>none</proc>
							<compileSourceRoots>
								<root>${project.basedir}/src/main/java</root>
								<root>${project.build.directory}/generated-sources/annotations</root>
							</compileSourceRoots>
							<generatedSourcesDirectory>
								${project.build.directory}/generated-sources/nothing-to-generate
							</generatedSourcesDirectory>
						</configuration>
					</execution>
					<!-- No entity lives in src/test/java, so there is no metamodel to
					     generate for the tests and nothing for a processor to do. -->
					<execution>
						<id>default-testCompile</id>
						<configuration>
							<proc>none</proc>
						</configuration>
					</execution>
				</executions>
			</plugin>
		</plugins>
	</build>

	<profiles>
		<!-- Backend-only work: no Node download, no client build, no client
		     tests. One switch, so that the install and the test run cannot be
		     skipped out of step with each other. -->
		<profile>
			<id>backend-only</id>
			<properties>
				<frontend.skip>true</frontend.skip>
				<frontend.test.skip>true</frontend.test.skip>
			</properties>
		</profile>
	</profiles>

</project>
